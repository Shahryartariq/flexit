# Supabase project: Settings → API (Project URL + publishable key).
# For local development, `pnpm db:start` prints both.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The public address of the site (used for metadata and share links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to 1 after enabling the GitHub provider in Supabase Auth to show "Continue with GitHub".
NEXT_PUBLIC_AUTH_GITHUB=
